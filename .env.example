# Puni bot — copy to .env and fill in. Secrets are NEVER committed.
# Bot token of the Puni Discord application (owner infra only)
DISCORD_BOT_TOKEN=
# Discord ID of the bot owner (Tín) — gates the owner admin panel / infra commands
OWNER_DISCORD_ID=
# Main guild (BNT Shop sales guild)
MAIN_GUILD_ID=1505404647924564091
# Bot database (PostgreSQL, the bot's OWN database — fully separate from any other system)
DATABASE_URL=
# Redis (cache / locks / job queue for shard+cluster, spec 2.5)
REDIS_URL=
# Total shards ("auto" = let discord.js compute from guild count)
TOTAL_SHARDS=auto

# --- Dashboard (discord.bntshop.com) ---
# Discord OAuth application (can be the same app as the bot)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://discord.bntshop.com/api/auth/callback
# Session signing secret (long random string, >= 16 chars)
SESSION_SECRET=
# Admin panel second factor (either or both; empty = owner-ID gate only)
ADMIN_PANEL_PASSWORD_SHA256=
OWNER_TOTP_SECRET=

# --- AI chat (@Puni mention replies, cute cat persona) ---
# Any OpenAI-compatible chat-completions endpoint. Empty key = feature off.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
